rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sidrastudentsunion@gmail.com' ||
        request.auth.token.email == 'sidrastudentunion@gmail.com' ||
        request.auth.token.email == 'sidraofficial359@gmail.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || (
        hasUserDoc() && getUserData().role == 'SUPER_ADMIN'
      );
    }

    function isTeacherAdmin() {
      return isSuperAdmin() || (
        hasUserDoc() && (
          getUserData().role == 'TEACHER_ADMIN' ||
          getUserData().role == 'SUPER_ADMIN'
        )
      );
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION
    // Authenticated users can read directory & manage their own profile
    // SUPER_ADMIN can manage all users
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();

      match /private/{privateDocId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // =========================================================================
    // STUDENTS COLLECTION
    // Read: All authenticated users (or public leaderboard)
    // Write/Update: SUPER_ADMIN and TEACHER_ADMIN
    // =========================================================================
    match /students/{studentId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    // =========================================================================
    // FACULTY MENTORS COLLECTION
    // Read: All authenticated users & public portal
    // Write/Update: SUPER_ADMIN and TEACHER_ADMIN
    // =========================================================================
    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    // =========================================================================
    // COIN CLAIMS COLLECTION
    // Read: All authenticated users
    // Create: Signed-in students & members
    // Approve / Reject / Write: TEACHER_ADMIN or SUPER_ADMIN
    // =========================================================================
    match /coin_claims/{claimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isTeacherAdmin();
    }

    // =========================================================================
    // COIN TRANSACTIONS COLLECTION
    // Read: All authenticated users
    // Write: SUPER_ADMIN and TEACHER_ADMIN (faculty awarding/revoking coins)
    // =========================================================================
    match /coin_transactions/{txId} {
      allow read: if isSignedIn();
      allow write: if isTeacherAdmin();
    }

    // =========================================================================
    // PUBLIC VIEWS & LEADERBOARD SUMMARIES
    // Read: Public (campus displays, website)
    // Write: SUPER_ADMIN and TEACHER_ADMIN
    // =========================================================================
    match /public_views/{viewId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    // =========================================================================
    // COIN CATEGORIES & RULES
    // Read: All authenticated users
    // Write: SUPER_ADMIN
    // =========================================================================
    match /coin_categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // UNIONS & HOUSES
    // Read: All authenticated users
    // Write: SUPER_ADMIN
    // =========================================================================
    match /unions/{unionId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // CLASS AWARDS
    // Read: All authenticated users
    // Write: TEACHER_ADMIN and SUPER_ADMIN
    // =========================================================================
    match /class_awards/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacherAdmin();
    }

    // =========================================================================
    // AUDIT LOGS
    // Read: TEACHER_ADMIN and SUPER_ADMIN
    // Create: Signed-in users recording institutional actions
    // Delete/Modify: SUPER_ADMIN
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isTeacherAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // ADMINS DIRECTORY
    // Read: All authenticated users
    // Write: SUPER_ADMIN
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
