{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Super Admin registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the Super Admin.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified institutional admin email.",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "description": "Elevated administrative role.",
          "enum": ["SUPER_ADMIN"]
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp when admin record was provisioned."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp when admin record was last updated."
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public/institutional non-PII user profile and RBAC role assignment keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Institutional display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Institutional access role.",
          "enum": ["SUPER_ADMIN", "TEACHER_ADMIN", "STUDENT", "VIEWER"]
        },
        "username": {
          "type": "string",
          "description": "Optional portal username identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "teacherId": {
          "type": "string",
          "description": "Official DHAC staff ID when role is TEACHER_ADMIN.",
          "maxLength": 32
        },
        "mentorDocId": {
          "type": "string",
          "description": "Firestore document ID in mentors collection.",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mentorName": {
          "type": "string",
          "description": "Assigned mentor display name.",
          "maxLength": 100
        },
        "studentDocId": {
          "type": "string",
          "description": "Firestore document ID in students collection when role is STUDENT.",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adNo": {
          "type": "string",
          "description": "Student admission number.",
          "maxLength": 20
        },
        "className": {
          "type": "string",
          "description": "Student academic class code.",
          "maxLength": 16
        },
        "photoUrl": {
          "type": "string",
          "description": "Profile avatar URL or compact data URI.",
          "maxLength": 50000
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp when profile was updated."
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection document storing user email and auth provider metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching parent user document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "providerId": {
          "type": "string",
          "description": "Authentication provider identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp when PII record was created."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp when PII record was updated."
        }
      },
      "required": ["uid", "email", "providerId", "createdAt", "updatedAt"]
    },
    "MentorRecord": {
      "title": "MentorRecord",
      "description": "Faculty mentor profile record in Darul Huda Assam Centre.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID for mentor (e.g., STAFF-01).",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serialNo": {
          "type": "string",
          "description": "Two-digit staff serial number.",
          "minLength": 1,
          "maxLength": 8
        },
        "teacherId": {
          "type": "string",
          "description": "Official institutional staff identifier (e.g., DHAC/STAFF/01).",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Full institutional name of the faculty mentor.",
          "minLength": 1,
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Staff portal identifier (e.g., STAFF.SHAFI).",
          "minLength": 1,
          "maxLength": 64
        },
        "assignedEmail": {
          "type": "string",
          "format": "email",
          "description": "Optional Google email authorized by Super Admin for this mentor.",
          "maxLength": 160
        },
        "isPublicDirectory": {
          "type": "boolean",
          "description": "Indicates inclusion in the campus mentor directory."
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp when mentor was added."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp when mentor was last updated."
        }
      },
      "required": ["id", "serialNo", "teacherId", "name", "username", "isPublicDirectory", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Institutional student merit coin balance, tier, and cohort rankings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student document ID (e.g., STU-635).",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "Canonical student identifier matching id.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "officialId": {
          "type": "string",
          "description": "Institutional ID string DHAC/ST/2026/[CLASS]/[ADNO].",
          "minLength": 1,
          "maxLength": 64
        },
        "adNo": {
          "type": "string",
          "description": "Admission number.",
          "minLength": 1,
          "maxLength": 20
        },
        "adFlag": {
          "type": "string",
          "description": "Admission number validation flag.",
          "enum": ["VALID", "ORIGINAL_ASTERISK", "MISSING_AD"]
        },
        "name": {
          "type": "string",
          "description": "Student full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "description": "Academic class code (S1A..D2).",
          "minLength": 1,
          "maxLength": 16
        },
        "batchName": {
          "type": "string",
          "description": "Union or batch title.",
          "maxLength": 48
        },
        "mentorName": {
          "type": "string",
          "description": "Assigned faculty mentor name.",
          "minLength": 1,
          "maxLength": 100
        },
        "totalCoins": {
          "type": "integer",
          "description": "Current cumulative confirmed merit coins (non-negative integer)."
        },
        "coinStatus": {
          "type": "string",
          "description": "Status of student coin ledger balance.",
          "enum": ["CONFIRMED", "MISSING_OR_ZERO", "ASSUMED_ZERO", "ZERO"]
        },
        "mentorGroupRank": {
          "type": "string",
          "description": "Formatted mentor group rank string.",
          "minLength": 1,
          "maxLength": 24
        },
        "mentorRankNum": {
          "type": "integer",
          "description": "Numeric mentor group rank (>= 1)."
        },
        "mentorGroupSize": {
          "type": "integer",
          "description": "Total students in mentor group (>= 1)."
        },
        "classRank": {
          "type": "string",
          "description": "Formatted class rank string.",
          "minLength": 1,
          "maxLength": 16
        },
        "classRankNum": {
          "type": "integer",
          "description": "Numeric class rank (>= 1)."
        },
        "classSize": {
          "type": "integer",
          "description": "Total students in class cohort (>= 1)."
        },
        "campusRank": {
          "type": "string",
          "description": "Formatted campus rank string.",
          "minLength": 1,
          "maxLength": 16
        },
        "campusRankNum": {
          "type": "integer",
          "description": "Numeric campus-wide competition rank (>= 1)."
        },
        "campusTotalStudents": {
          "type": "integer",
          "description": "Total students in campus cohort (>= 1)."
        },
        "rankStatus": {
          "type": "string",
          "description": "Official or provisional ranking classification.",
          "enum": ["OFFICIAL", "PROVISIONAL"]
        },
        "notes": {
          "type": "string",
          "description": "Registry audit notes.",
          "maxLength": 500
        },
        "tier": {
          "type": "string",
          "description": "Merit medal tier derived from totalCoins.",
          "enum": ["Diamond", "Gold", "Silver", "Bronze", "Starter", "Zero"]
        },
        "photoUrl": {
          "type": "string",
          "description": "Compact student portrait data URL.",
          "maxLength": 50000
        },
        "linkedUid": {
          "type": "string",
          "description": "Firebase Auth UID linked to this student profile.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "description": "Optional pre-authorized student email.",
          "maxLength": 160
        },
        "isPublicCohort": {
          "type": "boolean",
          "description": "True when student is an active member of the public cohort leaderboard."
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp when student record was created."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp when student record was updated."
        }
      },
      "required": [
        "id",
        "studentId",
        "officialId",
        "adNo",
        "adFlag",
        "name",
        "className",
        "batchName",
        "mentorName",
        "totalCoins",
        "coinStatus",
        "mentorGroupRank",
        "mentorRankNum",
        "mentorGroupSize",
        "classRank",
        "classRankNum",
        "classSize",
        "campusRank",
        "campusRankNum",
        "campusTotalStudents",
        "rankStatus",
        "notes",
        "tier",
        "isPublicCohort",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoinCategoryDoc": {
      "title": "CoinCategoryDoc",
      "description": "Official DHAC Merit Coin Rules category with bounded list of activity criteria.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Category document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "description": "Category title.",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Optional category summary.",
          "maxLength": 300
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display ordering index."
        },
        "activities": {
          "type": "array",
          "description": "Bounded list of up to 50 activity coin rules."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether category is active."
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp."
        },
        "updatedAt": {
          "type": "object",
          "description": "Firestore server timestamp."
        }
      },
      "required": ["id", "categoryName", "sortOrder", "activities", "isActive", "createdAt", "updatedAt"]
    },
    "UnionDoc": {
      "title": "UnionDoc",
      "description": "Student Union batch configuration mapping classes to campus unions.",
